{
  "expo": {
    "name": "Flashcards",
    "slug": "flashcards",
    "scheme": "flashcards",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-localization",
      "expo-apple-authentication",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.328552196530-i4gn6h9auldg5flt1mclutnt3v989pvv"
        }
      ]
    ],
    "android": {
      "package": "com.superedriver.flashcards.dev"
    }
  }
}
